# ==============================================================================
# Central Identity Service - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and replace placeholder values with secure credentials.
# In Staging and Production, all secrets MUST be cryptographically random.
# ==============================================================================

# --- Compose & Environment ---
COMPOSE_PROJECT_NAME=central-identity
ENVIRONMENT=dev

# --- Pinned Container Image Versions ---
KC_IMAGE_TAG=26.1.0
CONFIG_CLI_IMAGE_TAG=6.5.1-26.1.0
MAILPIT_IMAGE_TAG=v1.22.3

# --- External PostgreSQL Database ---
# Hostname or IP of the external database server (e.g. db.internal.mydomain.com, AWS RDS, etc.)
# If connecting to PostgreSQL hosted locally on the Docker host machine, use host.docker.internal
POSTGRES_HOST=postgres.example.com
POSTGRES_PORT=5432
POSTGRES_DB=keycloak
POSTGRES_USER=keycloak
POSTGRES_PASSWORD=replace_with_secure_postgres_password

# --- Keycloak Server ---
# Bootstrap admin account (used only on first startup to initialize the master realm)
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=replace_with_secure_admin_password

# Hostname and network bindings
# In local dev: http://localhost:8080 (KC_HOSTNAME_STRICT=false)
# In staging/prod: https://idp.mydomain.com (KC_HOSTNAME_STRICT=true)
KC_HOSTNAME=http://localhost:8080
KC_HOSTNAME_STRICT=false
KC_HTTP_ENABLED=true
KC_PROXY_HEADERS=xforwarded
KC_PORT=8080
KC_MANAGEMENT_PORT=9000
KC_LOG_LEVEL=INFO

# --- Mailpit (Dev SMTP Catcher) ---
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# --- Realm SMTP Configuration (used by Keycloak platform realm) ---
# In dev: points to the mailpit container on port 1025 without auth
# In staging/prod: point to AWS SES, SendGrid, or corporate SMTP relay
KC_SMTP_HOST=mailpit
KC_SMTP_PORT=1025
KC_SMTP_FROM=noreply@platform.local
KC_SMTP_AUTH=false
KC_SMTP_SSL=false
KC_SMTP_STARTTLS=false
KC_SMTP_USER=
KC_SMTP_PASSWORD=

# --- Phase 1 Product ("test") Client Credentials & URLs ---
# test-user-web: confidential client with auth code + PKCE (BFF)
TEST_USER_WEB_SECRET=replace_with_secure_test_user_web_secret
TEST_USER_WEB_REDIRECT_URI_1=http://localhost:3000/api/auth/callback/keycloak
TEST_USER_WEB_REDIRECT_URI_2=http://localhost:5000/signin-oidc
TEST_USER_WEB_WEB_ORIGIN_1=http://localhost:3000
TEST_USER_WEB_WEB_ORIGIN_2=http://localhost:5000

# test-admin-web: confidential client with auth code + PKCE (Admin BFF)
TEST_ADMIN_WEB_SECRET=replace_with_secure_test_admin_web_secret
TEST_ADMIN_WEB_REDIRECT_URI_1=http://localhost:3001/api/auth/callback/keycloak
TEST_ADMIN_WEB_REDIRECT_URI_2=http://localhost:5001/signin-oidc
TEST_ADMIN_WEB_WEB_ORIGIN_1=http://localhost:3001
TEST_ADMIN_WEB_WEB_ORIGIN_2=http://localhost:5001

# test-apiclient-example: confidential client with service accounts / client credentials
TEST_APICLIENT_SECRET=replace_with_secure_test_apiclient_secret

# --- Seeded Dev Users Passwords (DEV ONLY) ---
TEST_DEV_USER_PASSWORD=replace_with_dev_user_password
TEST_DEV_ADMIN_PASSWORD=replace_with_dev_admin_password
